{
  "name": "le-chateau-du-renard",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests index.html package.json tsconfig.json README.md",
    "test:production": "node tests/production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0"
  }
}
